--- /dev/null
+++ b/dm/android/java/org/d2r/android/port/TouchableGame.java
@@ -0,0 +1,46 @@
+package org.d2r.android.port;
+
+import android.content.Context;
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/* Present only in Touchable APKs. Default Akari APKs keep their original launcher contract. */
+final class TouchableGame {
+    private static final String ASSET = "touchable_game.json";
+    private final String[] modules;
+    private TouchableGame(String[] modules) { this.modules = modules; }
+    String[] modules() { return modules.clone(); }
+    boolean librariesPresent(File nativeDir) {
+        for (String module : modules)
+            if (!new File(nativeDir, "libdmguest_" + module + ".so").isFile()) return false;
+        return true;
+    }
+
+    static TouchableGame load(Context context) {
+        try (InputStream stream = context.getAssets().open(ASSET)) {
+            byte[] data = new byte[stream.available()];
+            int off = 0, n;
+            while (off < data.length && (n = stream.read(data, off, data.length - off)) > 0) off += n;
+            JSONObject root = new JSONObject(new String(data, 0, off, StandardCharsets.UTF_8));
+            JSONArray names = root.getJSONArray("module_names");
+            if (names.length() == 0) throw new IllegalStateException("Touchable game has no modules");
+            String[] modules = new String[names.length()];
+            for (int i = 0; i < modules.length; i++) {
+                String name = names.getString(i);
+                if (!name.matches("[A-Za-z0-9_-]+")) throw new IllegalStateException("Invalid game module: " + name);
+                modules[i] = name;
+            }
+            return new TouchableGame(modules);
+        } catch (IOException missing) {
+            /* Akari's own APK has no game metadata asset. */
+            return null;
+        } catch (JSONException bad) {
+            throw new IllegalStateException("Invalid " + ASSET, bad);
+        }
+    }
+}
