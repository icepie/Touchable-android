+            vibrator.cancel();
+            return;
+        }
+        int amplitude = Math.round(255.0f * Math.min(1.0f, intensity));
+        if (amplitude < 1) amplitude = 1;
+        phoneWaveAmplitudes[0] = amplitude;
+        phoneWaveAmplitudes[1] = amplitude;
+        try {
+            vibrator.vibrate(VibrationEffect.createWaveform(PHONE_WAVE_TIMINGS, phoneWaveAmplitudes, 0), GAME_VIBRATION_ATTRIBUTES);
+        } catch (RuntimeException error) {
+            Log.w("D2RAndroid", "[game-haptics] phone vibration failed", error);
+        }
+    }
