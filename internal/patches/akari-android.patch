+package org.d2r.android.port;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.graphics.RadialGradient;
+import android.graphics.Shader;
+import android.view.View;
+
+/* The window is deliberately not touchable. NativeActivity's input queue owns every finger;
+   this reads the same geometry/hints as the hit tester in ss_android_touch.c. */
+final class RhythmOverlay extends View {
+    interface Source { int draw(float[] out); }
+    private final Source source;
+    private final float[] snapshot = new float[10 + 9 * 6 + 16 * 4];
+    private final RadialGradient feedback = new RadialGradient(0, 0, 80,
+        new int[]{0x3dffffff, 0x1affffff, 0x00ffffff}, new float[]{0, .42f, 1}, Shader.TileMode.CLAMP);
+    private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF rect = new RectF();
+    private boolean controlsShown = true;
+
+    RhythmOverlay(Context context, Source source) { super(context); this.source = source; setLayerType(View.LAYER_TYPE_SOFTWARE, null); }
+    void setControlsShown(boolean shown) { if (controlsShown != shown) { controlsShown = shown; invalidate(); } }
+    private static String symbol(int bit) {
+        switch(bit) {
+            case 0: return "A"; case 1: return "B"; case 2: return "X"; case 3: return "Y";
+            case 10: return "+"; case 11: return "−";
+            case 12: return "◀"; case 13: return "▲"; case 14: return "▶"; case 15: return "▼";
+            default: return "•";
+        }
+    }
+    private void label(Canvas canvas, String text, float x, float y, float size, int alpha) {
+        paint.setStyle(Paint.Style.FILL);paint.setColor(Color.WHITE);paint.setAlpha(alpha);
+        paint.setTextAlign(Paint.Align.CENTER);paint.setTextSize(size);paint.setFakeBoldText(true);
+        canvas.drawText(text, x, y - (paint.ascent() + paint.descent()) / 2, paint);
+    }
+    @Override protected void onDraw(Canvas canvas) {
+        if (!controlsShown || source.draw(snapshot) != snapshot.length || snapshot[0] <= 0 || snapshot[1] <= 0) return;
+        float sx = getWidth() / snapshot[0], sy = getHeight() / snapshot[1];
+        canvas.save();canvas.scale(sx, sy);
+        float d = getResources().getDisplayMetrics().density;
+        float left = snapshot[2], right = snapshot[3], top = snapshot[4], bottom = snapshot[5];
+        if (left > 0 && right > left && bottom > top) {
+            rect.set(left, top, right, bottom);
+            paint.setStyle(Paint.Style.STROKE);paint.setStrokeWidth(d);paint.setColor(0x1affffff);
+            canvas.drawRoundRect(rect,18*d,18*d,paint);
+            paint.setColor(0x1affffff);canvas.drawLine((left+right)/2,top+16*d,(left+right)/2,bottom-16*d,paint);
+            label(canvas,symbol((int)snapshot[7]),(3*left+right)/4,(top+bottom)/2,36*d,71);
+            label(canvas,symbol((int)snapshot[8]),(left+3*right)/4,(top+bottom)/2,36*d,71);
+        }
+        for (int i = 9; i < 63; i += 6) {
+            int appearance=(int)snapshot[i+4];
+            if (appearance == 0 || appearance == 3) continue;
+            int bit=(int)snapshot[i];float x=snapshot[i+1],y=snapshot[i+2],r=snapshot[i+3]/2;
+            rect.set(x-r,y-r,x+r,y+r);
+            if (appearance == 1) {
+                paint.setStyle(Paint.Style.FILL);paint.setColor(snapshot[i+5]!=0?0x7095bfff:0x500d1827);
+                canvas.drawRoundRect(rect,r,r,paint);
+            }
+            paint.setStyle(Paint.Style.STROKE);paint.setStrokeWidth(d);paint.setColor(appearance==2?0x40ffffff:0xa8ffffff);
+            canvas.drawRoundRect(rect,r,r,paint);
+            label(canvas,symbol(bit),x,y,Math.min(23*d,r),appearance==2?64:230);
+        }
+        for (int i = 64; i < snapshot.length; i += 4) {
+            float alpha=snapshot[i+3];
+            if (alpha <= 0) continue;
+            float x=snapshot[i+1], y=snapshot[i+2];
+            canvas.save();canvas.translate(x,y);canvas.scale(d,d);
+            paint.setStyle(Paint.Style.FILL);paint.setColor(Color.WHITE);
+            paint.setAlpha(Math.round(255*alpha));paint.setShader(feedback);
+            canvas.drawCircle(0,0,80,paint);
+            paint.setShader(null);canvas.restore();
+            float captionX=Math.max(20*d,Math.min(x,snapshot[0]-20*d));
+            float captionY=Math.max(y-60*d,snapshot[63]+20*d);
+            paint.setShadowLayer(d,0,d,0x99000000);
+            label(canvas,symbol((int)snapshot[i]),captionX,captionY,26*d,Math.round(230*alpha));
+            paint.clearShadowLayer();
+        }
+        canvas.restore();
+    }
+}
diff --git a/dm/android/java/org/d2r/android/port/StandalonePackage.java b/dm/android/java/org/d2r/android/port/StandalonePackage.java
new file mode 100644
index 0000000..22737aa
--- /dev/null
+++ b/dm/android/java/org/d2r/android/port/StandalonePackage.java
@@ -0,0 +1,180 @@
+package org.d2r.android.port;
+
+import android.content.Context;
+import android.content.res.AssetManager;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.SequenceInputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.Enumeration;
+import java.util.NoSuchElementException;
+
+/** Automatic installation of the private, locally built standalone payload.
+ * Only d2r-package is written: files/save, external saves and developer data are never touched.
+ * Streams use bounded buffers and long sizes, including payloads larger than 2 GiB.
+ */
+final class StandalonePackage {
+    interface Observer {
+        void progress(int percent);
+        void finished(Exception error);
+    }
+
+    private static StandalonePackage instance;
+    private final Context context;
+    private final JSONObject descriptor;
+    private final File assets, modules, marker;
+    private final String id;
+    private Observer observer;
+    private boolean running, attempted;
+    private int percent;
+    private Exception failure;
+
+    private StandalonePackage(Context application, JSONObject value) throws IOException, JSONException {
+        context = application;
+        descriptor = value;
+        if (value.getInt("format") != 1) throw new IOException("Unsupported standalone payload format");
+        id = value.getString("id");
+        if (!id.matches("[0-9a-f]{64}")) throw new IOException("Invalid standalone payload identity");
+        File external = application.getExternalFilesDir(null);
+        if (external == null) throw new IOException("Private external storage is unavailable; reopen the app when storage is mounted");
+        assets = new File(external, "d2r-package");
+        modules = new File(application.getFilesDir(), "d2r-package/game");
+        marker = new File(assets, "standalone-ready.sha256");
+        JSONArray parts = value.getJSONArray("parts");
+        if (parts.length() == 0) throw new IOException("Standalone payload has no parts");
+        for (int i = 0; i < parts.length(); i++)
+            if (!parts.getString(i).matches("standalone/payload-[0-9]{3}\\.bin"))
+                throw new IOException("Invalid standalone payload part");
+    }
+
+    static synchronized StandalonePackage load(Context context) throws IOException {
+        if (instance != null) return instance;
+        boolean present = false;
+        for (String name : context.getAssets().list("")) if (name.equals("standalone.json")) present = true;
+        if (!present) return null;
+        try (InputStream stream = context.getAssets().open("standalone.json")) {
+            JSONObject descriptor = new JSONObject(new String(readSmall(stream), StandardCharsets.UTF_8));
+            instance = new StandalonePackage(context.getApplicationContext(), descriptor);
+            return instance;
+        } catch (JSONException error) {
+            throw new IOException("Invalid standalone metadata: " + error.getMessage(), error);
+        }
+    }
+
+    synchronized boolean ready() {
+        if (running || !new File(assets, PackageArchive.MANIFEST).isFile()
+                || !new File(assets, "romfs").isDirectory()
+                || !new File(assets, "shaders/host-subgroup-size.txt").isFile()) return false;
+        for (String name : PackageArchive.requiredModules()) if (!new File(modules, name).isFile()) return false;
+        try (InputStream stream = new FileInputStream(marker)) {
+            return id.equals(new String(readSmall(stream), StandardCharsets.UTF_8).trim());
+        } catch (IOException error) { return false; }
+    }
+
+    synchronized void observe(Observer value) {
+        observer = value;
+        if (value == null) return;
+        if (running) value.progress(percent);
+        else if (attempted || ready()) value.finished(failure);
+    }
+
+    synchronized void start(boolean retry) {
+        if (running || ready() || (attempted && !retry)) return;
+        running = true;
+        attempted = true;
+        failure = null;
+        percent = 0;
+        publishProgress(0);
+        new Thread(this::prepare, "touchable-standalone-prepare").start();
+    }
+
+    private synchronized void publishProgress(int value) {
+        percent = Math.min(99, value);
+        if (observer != null) observer.progress(percent);
+    }
+
+    private void prepare() {
+        Exception problem = null;
+        try {
+            long externalBytes = descriptor.getLong("external_bytes");
+            long internalBytes = descriptor.getLong("internal_bytes");
+            long totalBytes = descriptor.getLong("unpacked_bytes");
+            if (externalBytes < 0 || internalBytes < 0 || totalBytes != externalBytes + internalBytes)
+                throw new IOException("Invalid standalone payload sizes");
+            requireSpace(assets.getParentFile(), externalBytes + (64L << 20), "game data");
+            requireSpace(context.getFilesDir(), internalBytes + (64L << 20), "game modules and driver");
+            if (!assets.isDirectory() && !assets.mkdirs()) throw new IOException("Cannot create game data directory");
+            if (marker.exists() && !marker.delete()) throw new IOException("Cannot clear standalone completion marker");
+            final JSONArray parts = descriptor.getJSONArray("parts");
+            // SequenceInputStream opens only the next bounded asset; never one multi-GB Java array.
+            Enumeration<InputStream> streams = new Enumeration<InputStream>() {
+                private int index;
+                @Override public boolean hasMoreElements() { return index < parts.length(); }
+                @Override public InputStream nextElement() {
+                    if (!hasMoreElements()) throw new NoSuchElementException();
+                    try { return context.getAssets().open(parts.getString(index++), AssetManager.ACCESS_STREAMING); }
+                    catch (IOException | JSONException error) { throw new PayloadReadFailure(error); }
+                }
+            };
+            try (InputStream raw = new SequenceInputStream(streams)) {
+                PackageArchive.unpack(raw, assets, modules, totalBytes, new PackageArchive.Sink() {
+                    @Override public void progress(int value) { publishProgress(value); }
+                    @Override public boolean cancelled() { return false; }
+                }, StandalonePackage::declaration, TouchPack.NO_CONTENT_CHECK);
+            }
+            // PackageArchive validates ZIP CRCs, required modules and all declared file counts,
+            // and writes manifest.json last. This build identity is committed only afterward.
+            File temporary = new File(assets, marker.getName() + ".tmp");
+            try (FileOutputStream out = new FileOutputStream(temporary)) {
+                out.write((id + "\n").getBytes(StandardCharsets.UTF_8));
+                out.getFD().sync();
+            }
+            if (!temporary.renameTo(marker)) throw new IOException("Cannot commit standalone completion marker");
+        } catch (Exception error) { problem = error; }
+        synchronized (this) {
+            running = false;
+            failure = problem;
+            if (observer != null) observer.finished(problem);
+        }
+    }
+
+    private static void requireSpace(File directory, long needed, String label) throws IOException {
+        if (directory.getUsableSpace() < needed)
+            throw new IOException(String.format(java.util.Locale.US,
+                    "Not enough storage for %s: %.2f GiB free required. Free space and tap Prepare again.",
+                    label, needed / (double)(1L << 30)));
+    }
+
+    private static byte[] readSmall(InputStream stream) throws IOException {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        byte[] buffer = new byte[4096];
+        int count;
+        while ((count = stream.read(buffer)) != -1) {
+            if (out.size() + count > 65536) throw new IOException("Standalone metadata is too large");
+            out.write(buffer, 0, count);
+        }
+        return out.toByteArray();
+    }
+
+    private static PackageArchive.Declaration declaration(byte[] bytes) throws IOException {
+        try {
+            JSONObject value = new JSONObject(new String(bytes, StandardCharsets.UTF_8));
+            JSONObject counts = value.getJSONObject("counts");
+            return new PackageArchive.Declaration(value.getInt("format"), counts.getInt("game"),
+                    counts.getInt("romfs"), counts.getInt("shaders"), counts.getInt("touch"));
+        } catch (JSONException error) { throw new IOException("Invalid standalone manifest", error); }
+    }
+
+    private static final class PayloadReadFailure extends RuntimeException {
+        PayloadReadFailure(Exception cause) { super("Cannot read bundled game data: " + cause.getMessage(), cause); }
+    }
+}
