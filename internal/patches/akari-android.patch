+    // Guest rumble is a continuous mono mix, not a touch-feedback pulse.  Use
+    // the GAME usage so system touch-haptics settings do not suppress it.
+    // The repeating waveform is replaced only when the mixed output changes;
+    // zero cancels it, so suspension never replays a stale effect.
+    public void phoneHaptic(float intensity, float sharpness) {
+        if (vibrator == null || !vibrator.hasVibrator()) return;
